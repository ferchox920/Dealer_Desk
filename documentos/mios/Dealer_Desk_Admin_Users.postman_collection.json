            {
              "name": "Create User Staff",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "var now = Date.now();",
                      "pm.environment.set('staffEmail', 'staff+' + now + '@dealerdesk.local');",
                      "pm.environment.set('staffName', 'Juan Staff ' + now);",
                      "if (!pm.environment.get('staffPassword')) pm.environment.set('staffPassword', 'Staff12345');"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                      "var json = pm.response.json();",
                      "pm.environment.set('staffId', json.data.id);"
                    ]
