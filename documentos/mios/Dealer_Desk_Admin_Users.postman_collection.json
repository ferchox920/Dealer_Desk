                "url": {
                  "raw": "{{baseURL}}/api/admin/auth/logout",
                  "host": [
                    "{{baseURL}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "auth",
                    "logout"
                  ]
                }
              },
              "response": []
            }
          ]
