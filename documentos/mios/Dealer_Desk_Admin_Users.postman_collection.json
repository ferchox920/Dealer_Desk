        {
          "name": "Auth",
          "item": [
            {
              "name": "Login Admin Owner",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                      "var json = pm.response.json();",
                      "pm.environment.set('ownerAccessToken', json.data.accessToken);",
                      "pm.environment.set('tokenAcces', json.data.accessToken);",
                      "pm.environment.set('accessToken', json.data.accessToken);",
                      "pm.environment.set('ownerId', json.data.admin.id);",
                      "pm.environment.set('currentRole', json.data.admin.role);"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseURL}}/api/admin/auth/login",
                  "host": [
                    "{{baseURL}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "auth",
                    "login"
                  ]
                }
              },
              "response": []
            },
