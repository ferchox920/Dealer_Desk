                  "path": [
                    "api",
                    "admin",
                    "auth",
                    "me"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Refresh Current Session",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                      "var json = pm.response.json();",
                      "pm.environment.set('tokenAcces', json.data.accessToken);",
                      "pm.environment.set('accessToken', json.data.accessToken);",
                      "if (json.data.admin.role === 'owner') pm.environment.set('ownerAccessToken', json.data.accessToken);",
                      "if (json.data.admin.role === 'staff') pm.environment.set('staffAccessToken', json.data.accessToken);"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseURL}}/api/admin/auth/refresh",
                  "host": [
                    "{{baseURL}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "auth",
                    "refresh"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Logout Current Session",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.environment.unset('tokenAcces');",
                      "pm.environment.unset('accessToken');",
                      "pm.environment.unset('currentRole');"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
