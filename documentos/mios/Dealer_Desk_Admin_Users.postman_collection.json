              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{tokenAcces}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "GET",
                "header": [],
