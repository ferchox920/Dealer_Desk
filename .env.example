# ============================================================================
# Dealer Desk - .env.example
#
# Regla rapida:
# - lo que aparece aqui es una guia
# - los valores reales los colocas tu
# - si una variable dice "opcional", puedes omitirla y el sistema usara su default
# ============================================================================


# ============================================================================
# SERVER
# ============================================================================

# Obligatoria.
# Puerto donde levanta el backend Express.
PORT=3000

# Opcionales.
# Puertos de la nueva base de microservicios.
# Si no los defines, usan defaults internos.
GATEWAY_PORT=3001
IDENTITY_SERVICE_PORT=3101
CATALOG_SERVICE_PORT=3201
PLATFORM_SERVICE_PORT=3301

# Opcional.
# URL interna que usa el gateway para hablar con identity-service.
IDENTITY_SERVICE_URL=http://localhost:3101
CATALOG_SERVICE_URL=http://localhost:3201
PLATFORM_SERVICE_URL=http://localhost:3301

# Opcional.
# Solo para bootstrap de microservicios o pruebas de routing.
# Si vale true, identity-service levanta sin probar DB al iniciar.
IDENTITY_SKIP_DB_CONNECT=false

# Recomendada.
# Usa "development" en local y "production" en produccion.
# Afecta sobre todo comportamiento de cookies y seguridad.
NODE_ENV=development

# Obligatoria.
# URL del frontend admin.
# Se usa para CORS y como base del enlace de setup/reset si no defines una URL mas especifica.
ADMIN_APP_ORIGIN=http://localhost:3001

# Opcional.
# URL exacta de la pantalla del front donde el usuario crea o restablece password.
# Si la omites, el backend usa:
# ADMIN_APP_ORIGIN + "/password-action"
ADMIN_APP_PASSWORD_ACTION_URL=http://localhost:3001/password-action


# ============================================================================
# DATABASE
# ============================================================================

# Recomendada.
# "safe" para desarrollo normal.
# "force" solo si quieres recrear tablas y perder datos locales.
DB_SYNC_MODE=safe

# Opcionales por servicio.
# Si no los defines, cada servicio cae al DB_SYNC_MODE compartido.
IDENTITY_DB_SYNC_MODE=safe
CATALOG_DB_SYNC_MODE=safe
PLATFORM_DB_SYNC_MODE=safe

# Obligatorias.
# Credenciales y conexion de PostgreSQL.
DB_NAME=dealer_desk
DB_USER=postgres
DB_PASS=replace_me
DB_HOST=localhost
DB_PORT=5432

# Opcionales para platform-service.
# Si no los defines, platform-service cae a los DB_* compartidos para desarrollo local.
PLATFORM_DB_NAME=
PLATFORM_DB_USER=
PLATFORM_DB_PASS=
PLATFORM_DB_HOST=
PLATFORM_DB_PORT=

# Opcionales para auth de plataforma.
PLATFORM_JWT_ACCESS_SECRET=
PLATFORM_JWT_ISSUER=dealer-desk-platform
PLATFORM_JWT_AUDIENCE=dealer-desk-platform-api
PLATFORM_ACCESS_TOKEN_TTL=15m
PLATFORM_REFRESH_TOKEN_TTL_DAYS=30
PLATFORM_SUPER_ADMIN_EMAIL=
PLATFORM_SUPER_ADMIN_NAME=
PLATFORM_SUPER_ADMIN_PASSWORD=


# ============================================================================
# JWT / AUTH
# ============================================================================

# Obligatoria.
# Clave secreta del backend para firmar y validar access tokens JWT.
# Debe ser privada, larga y aleatoria.
# Recomendacion real: 32+ caracteres.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters

# Obligatoria en la arquitectura de microservicios.
# Secreto interno compartido entre gateway y servicios para aceptar solo trafico interno.
INTERNAL_SERVICE_SECRET=replace_with_a_long_random_internal_secret_of_at_least_24_characters

# Opcionales.
# Metadatos del token. Puedes dejarlos asi si no necesitas cambiarlos.
JWT_ISSUER=dealer-desk-admin
JWT_AUDIENCE=dealer-desk-admin-api

# Opcional.
# Duracion del access token.
# Default real del sistema: 15m
ACCESS_TOKEN_TTL=15m

# Opcional.
# Duracion del refresh token en dias.
# Default real del sistema: 30
REFRESH_TOKEN_TTL_DAYS=30


# ============================================================================
# COOKIES
# ============================================================================

# Recomendada.
# En produccion conviene dejarla en true.
# En local normalmente false, a menos que trabajes con HTTPS local.
COOKIE_SECURE=false


# ============================================================================
# MAIL / EMAILS
# ============================================================================
#
# Usa SOLO UNO de estos dos esquemas:
#
# Opcion A: variables genericas MAIL_*
# Opcion B: aliases Gmail actuales del proyecto
#
# No necesitas llenar ambas opciones al mismo tiempo.
# ----------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Opcion A - MAIL_* generico
# ---------------------------------------------------------------------------

# Opcional si usas la opcion B.
# Ejemplo comun: Gmail
MAIL_SERVICE=Gmail

# Opcionales si usas MAIL_SERVICE.
MAIL_USER=replace_me@example.com
MAIL_PASS=replace_me

# Opcional.
# Nombre visible del remitente en el correo.
# Si la omites, el sistema usa el mismo usuario del correo.
MAIL_FROM=Dealer Desk <replace_me@example.com>

# Opcionales.
# Utiles si prefieres configurar host/puerto en vez de MAIL_SERVICE.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false

# ---------------------------------------------------------------------------
# Opcion B - aliases Gmail compatibles con este proyecto
# ---------------------------------------------------------------------------

# Opcional si usas la opcion A.
# Cuenta emisora real desde donde salen los correos del sistema.
EMAIL_NODEMAIL=replace_me@gmail.com

# Opcional si usas la opcion A.
# App password de Gmail para la cuenta anterior.
TOKEN_GMAIL=replace_me

# ---------------------------------------------------------------------------
# Config comun del flujo de password por correo
# ---------------------------------------------------------------------------

# Opcional.
# Horas de vida del enlace de setup/reset.
# Default real del sistema: 12
PASSWORD_ACTION_TOKEN_TTL_HOURS=12


# ============================================================================
# SEED OWNER
# ============================================================================
#
# Estas variables solo se usan si corres:
# npm run seed:owner
# ----------------------------------------------------------------------------

# Opcional.
# Email del primer owner.
# Si la omites, usa owner@dealerdesk.local
SEED_OWNER_EMAIL=

# Opcional.
# Nombre del primer owner.
# Si la omites, usa "System Owner"
SEED_OWNER_NAME=

# Opcional.
# Si la dejas vacia, el script crea el owner pendiente y manda invitacion por correo.
# Si la llenas, debe cumplir la policy fuerte del sistema:
# - minimo 8 caracteres
# - al menos 1 mayuscula
# - al menos 1 numero
# - al menos 1 caracter especial
SEED_OWNER_PASSWORD=


# ============================================================================
# CLOUDINARY
# ============================================================================
#
# Estas variables son necesarias para el modulo de imagenes.
# Si el backend toca productos/imagenes, deben existir.
# ----------------------------------------------------------------------------

CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
